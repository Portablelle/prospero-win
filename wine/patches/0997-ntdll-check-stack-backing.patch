From: Prospero Win local fixes <prospero-win@local>
Subject: [PATCH] ntdll: commit stack growth as one protection transaction

--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -4959,7 +4959,12 @@
 
         set_page_vprot_bits( guard, top + host_page_size, VPROT_COMMITTED, 0 );
         set_page_vprot_bits( guard, host_page_size, VPROT_GUARD, 0 );
-        mprotect_range( guard, top + host_page_size, 0, 0 );
+        if (mprotect_range( guard, top + host_page_size, 0, 0 ))
+        {
+            delete_view( view );
+            status = STATUS_NO_MEMORY;
+            goto done;
+        }
     }
     /* setup no access guard page */
     else if (guard_page)
@@ -4967,7 +4972,12 @@
         set_page_vprot( view->base, host_page_size, 0 );
         set_page_vprot( (char *)view->base + host_page_size, host_page_size,
                         VPROT_READ | VPROT_WRITE | VPROT_COMMITTED | VPROT_GUARD );
-        mprotect_range( view->base, 2 * host_page_size , 0, 0 );
+        if (mprotect_range( view->base, 2 * host_page_size, 0, 0 ))
+        {
+            delete_view( view );
+            status = STATUS_NO_MEMORY;
+            goto done;
+        }
     }
     VIRTUAL_DEBUG_DUMP_VIEW( view );
 
@@ -5105,24 +5115,27 @@
 /***********************************************************************
  *           grow_thread_stack
  */
+/* All protection changes are prepared against the old metadata. Only
+ * after both the data range and new guard succeed is either published. */
 static NTSTATUS grow_thread_stack( struct thread_data *data, char *page, struct thread_stack_info *stack_info )
 {
     NTSTATUS ret = 0;
-
-    set_page_vprot_bits( page, host_page_size, VPROT_COMMITTED, VPROT_GUARD );
-    mprotect_range( page, host_page_size, 0, 0 );
+    char *guard = NULL, *end = max( stack_info->limit, page + host_page_size );
+    SIZE_T size;
+
     if (page >= stack_info->start + host_page_size + stack_info->guaranteed)
-    {
-        set_page_vprot_bits( page - host_page_size, host_page_size, VPROT_COMMITTED | VPROT_GUARD, 0 );
-        mprotect_range( page - host_page_size, host_page_size, 0, 0 );
-    }
-    else  /* inside guaranteed space -> overflow exception */
+        guard = page - host_page_size;
+    else
     {
         page = stack_info->start + host_page_size;
-        set_page_vprot_bits( page, stack_info->guaranteed, VPROT_COMMITTED, VPROT_GUARD );
-        mprotect_range( page, stack_info->guaranteed, 0, 0 );
+        end = max( end, page + stack_info->guaranteed );
         ret = STATUS_STACK_OVERFLOW;
     }
+    size = end - page;
+    if (mprotect_range( page, size, VPROT_COMMITTED, VPROT_GUARD )) goto failed;
+    if (guard && mprotect_range( guard, host_page_size, VPROT_COMMITTED | VPROT_GUARD, 0 )) goto failed;
+    set_page_vprot_bits( page, size, VPROT_COMMITTED, VPROT_GUARD );
+    if (guard) set_page_vprot_bits( guard, host_page_size, VPROT_COMMITTED | VPROT_GUARD, 0 );
     if (stack_info->is_wow)
     {
         WOW_TEB *wow_teb = get_wow_teb( data->teb );
@@ -5130,6 +5143,15 @@
     }
     else data->teb->Tib.StackLimit = page;
     return ret;
+failed:
+    /* Restore every touched range, including the range that failed. Old
+     * metadata is intact. A failed rollback cannot safely resume a thread. */
+    {
+        int restore_data = mprotect_range( page, size, 0, 0 );
+        int restore_guard = guard ? mprotect_range( guard, host_page_size, 0, 0 ) : 0;
+        if (restore_data || restore_guard) abort_process(1);
+    }
+    return STATUS_NO_MEMORY;
 }
 
 
@@ -5162,8 +5184,6 @@
  */
 static NTSTATUS grow_thread_stack_to( struct thread_data *data, char *page, struct thread_stack_info *stack_info )
 {
-    set_page_vprot_bits( page, stack_info->limit - page, VPROT_COMMITTED, VPROT_GUARD );
-    mprotect_range( page, stack_info->limit - page, 0, 0 );
     return grow_thread_stack( data, page, stack_info );
 }
 
@@ -5274,6 +5294,14 @@
         mutex_lock( &virtual_mutex );  /* no need for signal masking inside signal handler */
         if (get_host_page_vprot( page ) & VPROT_GUARD) grown = grow_thread_stack( data, page, &stack_info );
         else if (is_stack_reserve( data, page, &stack_info )) grown = grow_thread_stack_to( data, page, &stack_info );
+        if (grown && grown != STATUS_STACK_OVERFLOW)
+        {
+            /* There is nowhere safe to place an exception context. Do not
+             * return a pointer into the still inaccessible reserve. */
+            mutex_unlock( &virtual_mutex );
+            ERR( "cannot back exception stack, status %#x\n", (unsigned)grown );
+            abort_thread(1);
+        }
         if (grown)
         {
             rec->ExceptionCode = STATUS_STACK_OVERFLOW;
