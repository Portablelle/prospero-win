     }
     if (!threshold || ps5_directory_fds <= (unsigned int)threshold) return;
     if (fd->unix_fd == -1 || !fd->inode || !fd->closed || !fd->unix_name || fd->closed->disp_flags ||
@@ -2024,6 +2027,17 @@
         file_set_error();
         goto failed;
     }
+#ifdef PS5_PARK_DIRECTORIES
+    /* A duplicate keeps its own absolute name even while its fd is open.
+     * Track it immediately so a parent rename updates that name as well. */
+    if (orig->ps5_counted)
+    {
+        fd->ps5_counted = 1;
+        fd->ps5_park_flags = orig->ps5_park_flags;
+        ps5_directory_fds++;
+        list_add_tail( &ps5_directories, &fd->ps5_directory_entry );
+    }
+#endif
     return fd;
 
 failed:
@@ -2742,9 +2756,74 @@
 #endif
 }
 
+#ifdef PS5_PARK_DIRECTORIES
+/* Preallocate every affected absolute name before renaming the parent.
+ * Descendants, including currently open directories that may later park,
+ * must not retain the old prefix. No allocation is needed after rename. */
+struct ps5_rename_path { struct ps5_rename_path *next; struct fd *fd; char *name; };
+static void ps5_finish_rename( struct ps5_rename_path *plan, int apply )
+{
+    while (plan)
+    {
+        struct ps5_rename_path *next = plan->next;
+        if (apply)
+        {
+            free( plan->fd->unix_name );
+            plan->fd->closed->unix_name = plan->fd->unix_name = plan->name;
+        }
+        else free( plan->name );
+        free( plan );
+        plan = next;
+    }
+}
+static struct ps5_rename_path *ps5_prepare_rename( struct fd *fd, const char *name )
+{
+    struct ps5_rename_path *plan = NULL, *item;
+    struct fd *other;
+    const char *slash = strrchr( name, '/' );
+    char *parent, *resolved, *root;
+    size_t parent_size, root_size, old_size = strlen( fd->unix_name );
+
+    if (!slash || !slash[1]) { set_error( STATUS_OBJECT_NAME_INVALID ); return NULL; }
+    parent_size = slash == name ? 1 : slash - name;
+    if (!(parent = mem_alloc( parent_size + 1 ))) return NULL;
+    memcpy( parent, name, parent_size ); parent[parent_size] = 0;
+    resolved = realpath_dup( parent );
+    free( parent );
+    if (!resolved) { file_set_error(); return NULL; }
+    root_size = strlen( resolved ) + strlen( slash + 1 ) + 2;
+    root = mem_alloc( root_size );
+    if (!root) { free( resolved ); return NULL; }
+    snprintf( root, root_size, "%s%s%s", resolved, !strcmp( resolved, "/" ) ? "" : "/", slash + 1 );
+    free( resolved );
+    if (!(plan = mem_alloc( sizeof(*plan) ))) { free( root ); return NULL; }
+    plan->next = NULL; plan->fd = fd; plan->name = root;
+    LIST_FOR_EACH_ENTRY( other, &ps5_directories, struct fd, ps5_directory_entry )
+    {
+        const char *suffix;
+        if (other == fd || !other->unix_name || !other->closed ||
+            strncmp( other->unix_name, fd->unix_name, old_size )) continue;
+        suffix = other->unix_name + old_size;
+        if (*suffix && *suffix != '/') continue;
+        if (!(item = mem_alloc( sizeof(*item) ))) goto failed;
+        item->name = mem_alloc( strlen(root) + strlen(suffix) + 1 );
+        if (!item->name) { free(item); goto failed; }
+        strcpy( item->name, root ); strcat( item->name, suffix );
+        item->fd = other; item->next = plan; plan = item;
+    }
+    return plan;
+failed:
+    ps5_finish_rename( plan, 0 );
+    return NULL;
+}
+#endif
+
 static void set_reparse_point( struct fd *fd, struct async *async )
 {
     char *reparse_name;
+#ifdef PS5_PARK_DIRECTORIES
+    struct ps5_rename_path *plan;
+#endif
