     size_t len;
 
@@ -2783,13 +2862,26 @@
         memcpy( reparse_name, fd->unix_name, len );
         strcpy( reparse_name + len, "?" );
 
+#ifdef PS5_PARK_DIRECTORIES
+        plan = ps5_prepare_rename( fd, reparse_name );
+        if (!plan) { free( reparse_name ); return; }
+#endif
         if (rename( fd->unix_name, reparse_name ))
         {
+#ifdef PS5_PARK_DIRECTORIES
+            ps5_finish_rename( plan, 0 );
+#endif
+            file_set_error();
             free( reparse_name );
             return;
         }
+#ifdef PS5_PARK_DIRECTORIES
