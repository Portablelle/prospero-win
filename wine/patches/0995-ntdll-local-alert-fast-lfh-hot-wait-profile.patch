+
+NTSTATUS WINAPI NtWaitForAlertByThreadId(const void *address, const LARGE_INTEGER *timeout)
+{
+#ifdef __PROSPERO__
+    ULONGLONG start = pw_tf3_profile_begin();
+    NTSTATUS ret = pw_tf3_orig_NtWaitForAlertByThreadId(address, timeout);
+    pw_tf3_alert_result(timeout, ret);
+    pw_tf3_profile_end(0, start);
+    return ret;
+#else
+    return pw_tf3_orig_NtWaitForAlertByThreadId(address, timeout);
+#endif
+}
+
+NTSTATUS WINAPI NtWaitForSingleObject(HANDLE handle, BOOLEAN alertable, const LARGE_INTEGER *timeout)
+{
+#ifdef __PROSPERO__
+    ULONGLONG start = pw_tf3_profile_begin();
+    NTSTATUS ret = pw_tf3_orig_NtWaitForSingleObject(handle, alertable, timeout);
+    pw_tf3_profile_end(1, start);
+    return ret;
+#else
+    return pw_tf3_orig_NtWaitForSingleObject(handle, alertable, timeout);
+#endif
+}
+
+NTSTATUS WINAPI NtWaitForMultipleObjects(DWORD count, const HANDLE *handles, WAIT_TYPE type, BOOLEAN alertable, const LARGE_INTEGER *timeout)
+{
+#ifdef __PROSPERO__
+    ULONGLONG start = pw_tf3_profile_begin();
+    NTSTATUS ret = pw_tf3_orig_NtWaitForMultipleObjects(count, handles, type, alertable, timeout);
+    pw_tf3_profile_end(2, start);
+    return ret;
+#else
+    return pw_tf3_orig_NtWaitForMultipleObjects(count, handles, type, alertable, timeout);
+#endif
+}
+
+NTSTATUS WINAPI NtDelayExecution(BOOLEAN alertable, const LARGE_INTEGER *timeout)
+{
+#ifdef __PROSPERO__
+    ULONGLONG start = pw_tf3_profile_begin();
+    NTSTATUS ret = pw_tf3_orig_NtDelayExecution(alertable, timeout);
+    pw_tf3_profile_end(3, start);
+    return ret;
+#else
+    return pw_tf3_orig_NtDelayExecution(alertable, timeout);
+#endif
+}
+
+#ifdef __PROSPERO__
+#include <sys/cpuset.h>
+#include <pthread_np.h>
+enum { PW_TF3_WAIT_ALERT, PW_TF3_WAIT_SINGLE, PW_TF3_WAIT_MULTIPLE,
+       PW_TF3_DELAY, PW_TF3_SERVER, PW_TF3_PROFILE_COUNT };
+struct pw_tf3_profile {
+    ULONGLONG since, calls[PW_TF3_PROFILE_COUNT], ticks[PW_TF3_PROFILE_COUNT];
+    ULONGLONG max[PW_TF3_PROFILE_COUNT], cpu_us;
+    int cpu_valid;
+    ULONGLONG alert_timed, alert_short, alert_timeouts, alert_woken, alert_errors;
+    ULONGLONG alert_fast[5];
+    unsigned observe_calls;
+    int observe_valid;
+    struct rusage observe_ru;
+};
+static pthread_once_t pw_tf3_once = PTHREAD_ONCE_INIT;
+static pthread_key_t pw_tf3_key;
+static ULONGLONG pw_tf3_hz;
+static int pw_tf3_observe;
+static void pw_tf3_observe_report(struct pw_tf3_profile *p, ULONGLONG now);
+static int pw_tf3_cpu(ULONGLONG *out);
+static ULONGLONG pw_tf3_rdtsc(void)
+{
+    unsigned lo, hi;
+    __asm__ volatile("lfence; rdtsc" : "=a"(lo), "=d"(hi) :: "memory");
+    return ((ULONGLONG)hi << 32) | lo;
+}
+static void pw_tf3_init(void)
+{
+    const char *enable = getenv("PW_WINE_NT_PROFILE");
+    const char *validated = getenv("PW_QPC_TSC_VALIDATED");
+    const char *text = getenv("PW_QPC_TSC_HZ");
+    char *end;
+    ULONGLONG hz;
+    if (!enable || (strcmp(enable, "1") && strcmp(enable, "2"))) return;
+    if (!validated || strcmp(validated, "1") || !text) return;
+    hz = strtoull(text, &end, 10);
+    if (*end || hz < 100000000 || hz > 10000000000ull) return;
+    if (pthread_key_create(&pw_tf3_key, free)) return;
+    pw_tf3_hz = hz;
+    pw_tf3_observe = !strcmp(enable, "2");
+    if (pw_tf3_observe) {
+        fprintf(stderr, "PW_WINE_SCHED_OBSERVE version=1 start tsc_hz=%llu interval_s=5 clock_check_every=1024 policy_rr=%d policy_fifo=%d\n", (unsigned long long)hz, SCHED_RR, SCHED_FIFO);
+        return;
+    }
+    fprintf(stderr, "PW_WINE_NT_PROFILE version=1 start tsc_hz=%llu scope=inclusive-nt-waits\n", (unsigned long long)hz);
+}
+ULONGLONG pw_tf3_profile_begin(void)
+{
+    struct pw_tf3_profile *p;
+    pthread_once(&pw_tf3_once, pw_tf3_init);
+    if (!pw_tf3_hz) return 0;
+    p = pthread_getspecific(pw_tf3_key);
+    if (!p) {
+        p = calloc(1, sizeof(*p));
+        if (!p) return 0;
+        p->cpu_valid = pw_tf3_cpu(&p->cpu_us);
+        p->since = pw_tf3_rdtsc();
+        if (pthread_setspecific(pw_tf3_key, p)) { free(p); return 0; }
+    }
+    if (pw_tf3_observe) {
+        if (!p->observe_calls || !(p->observe_calls & 1023)) {
+            ULONGLONG now = pw_tf3_rdtsc();
+            if (!p->observe_calls || now - p->since >= pw_tf3_hz * 5)
+                pw_tf3_observe_report(p, now);
+        }
+        p->observe_calls++;
+        return 0;
+    }
+    return pw_tf3_rdtsc();
+}
+static int pw_tf3_cpu(ULONGLONG *out)
+{
+    struct rusage ru;
+    if (getrusage(RUSAGE_THREAD, &ru)) return 0;
+    *out = (ULONGLONG)ru.ru_utime.tv_sec * 1000000 + ru.ru_utime.tv_usec
+         + (ULONGLONG)ru.ru_stime.tv_sec * 1000000 + ru.ru_stime.tv_usec;
+    return 1;
+}
+
+static ULONGLONG pw_tf3_ru_us(const struct rusage *ru)
+{
+    return (ULONGLONG)ru->ru_utime.tv_sec * 1000000 + ru->ru_utime.tv_usec
+         + (ULONGLONG)ru->ru_stime.tv_sec * 1000000 + ru->ru_stime.tv_usec;
+}
+static void pw_tf3_observe_report(struct pw_tf3_profile *p, ULONGLONG now)
+{
+    struct sched_param param = {0};
+    struct rusage ru = {0};
+    cpuset_t mask;
+    int policy = -1, sched_status, affinity_status, ru_status, valid;
+    unsigned i, cpus = 0;
+    ULONGLONG low_mask = 0, cpu = 0, previous = 0;
+    long voluntary = 0, involuntary = 0;
+    CPU_ZERO(&mask);
+    sched_status = pthread_getschedparam(pthread_self(), &policy, &param);
+    affinity_status = pthread_getaffinity_np(pthread_self(), sizeof(mask), &mask);
+    if (!affinity_status) for (i = 0; i < CPU_SETSIZE; i++) {
+        if (!CPU_ISSET(i, &mask)) continue;
+        cpus++;
+        if (i < 64) low_mask |= (ULONGLONG)1 << i;
+    }
+    ru_status = getrusage(RUSAGE_THREAD, &ru);
+    if (ru_status) ru_status = errno;
+    if (!ru_status) { cpu = pw_tf3_ru_us(&ru); previous = pw_tf3_ru_us(&p->observe_ru); }
+    valid = !ru_status && p->observe_valid && cpu >= previous && now > p->since;
+    if (valid) {
+        voluntary = ru.ru_nvcsw - p->observe_ru.ru_nvcsw;
+        involuntary = ru.ru_nivcsw - p->observe_ru.ru_nivcsw;
+    }
+    fprintf(stderr, "PW_WINE_SCHED_OBSERVE version=1 tid=%04x initial=%d wall_us=%llu cpu_valid=%d cpu_us=%llu ru_status=%d voluntary=%ld involuntary=%ld sched_status=%d policy=%d priority=%d affinity_status=%d affinity_low64=%llx cpu_count=%u\n",
+            (unsigned)get_thread_data()->tid, !p->observe_calls,
+            (unsigned long long)((now - p->since) * 1000000 / pw_tf3_hz), valid,
+            (unsigned long long)(valid ? cpu - previous : 0), ru_status,
+            voluntary, involuntary, sched_status, sched_status ? -1 : policy,
+            sched_status ? -1 : param.sched_priority, affinity_status,
+            (unsigned long long)low_mask, cpus);
+    /* Refresh both baselines after logging, so they describe the same window. */
+    p->observe_valid = !getrusage(RUSAGE_THREAD, &p->observe_ru);
+    p->since = pw_tf3_rdtsc();
+}
+
+void pw_tf3_alert_fast_event(unsigned event)
+{
+    struct pw_tf3_profile *p;
+    if (!pw_tf3_hz || pw_tf3_observe || event >= 5) return;
+    if ((p = pthread_getspecific(pw_tf3_key))) p->alert_fast[event]++;
+}
+void pw_tf3_alert_result(const LARGE_INTEGER *timeout, NTSTATUS ret)
+{
+    struct pw_tf3_profile *p;
+    if (!pw_tf3_hz || pw_tf3_observe || !(p = pthread_getspecific(pw_tf3_key))) return;
+    if (timeout && timeout->QuadPart != TIMEOUT_INFINITE)
+    {
+        p->alert_timed++;
+        if (timeout->QuadPart <= 0 && timeout->QuadPart >= -1000) p->alert_short++;
+    }
+    if (ret == STATUS_ALERTED) p->alert_woken++;
+    else if (ret == STATUS_TIMEOUT) p->alert_timeouts++;
+    else p->alert_errors++;
+}
+void pw_tf3_profile_end(unsigned id, ULONGLONG start)
+{
+    static const char *names[] = {"alert", "single", "multiple", "delay", "server"};
+    struct pw_tf3_profile *p;
+    ULONGLONG now, delta, cpu = 0;
+    int cpu_valid;
+    char line[720];
+    size_t at;
+    unsigned i;
+    if (!start || id >= PW_TF3_PROFILE_COUNT) return;
+    now = pw_tf3_rdtsc();
+    if (now < start) return;
+    p = pthread_getspecific(pw_tf3_key);
+    if (!p) return;
+    delta = now - start;
+    p->calls[id]++; p->ticks[id] += delta;
+    if (delta > p->max[id]) p->max[id] = delta;
+    if (now - p->since < pw_tf3_hz * 5) return;
+    cpu_valid = pw_tf3_cpu(&cpu) && p->cpu_valid && cpu >= p->cpu_us;
+    at = snprintf(line, sizeof(line), "PW_WINE_NT_PROFILE version=1 tid=%04x wall_us=%llu cpu_valid=%d cpu_us=%llu",
+                  (unsigned)get_thread_data()->tid,
+                  (unsigned long long)((now-p->since) * 1000000 / pw_tf3_hz), cpu_valid,
+                  (unsigned long long)(cpu_valid ? cpu-p->cpu_us : 0));
+    for (i = 0; i < PW_TF3_PROFILE_COUNT && at < sizeof(line); i++)
+        at += snprintf(line+at, sizeof(line)-at, " %s=%llu/%llu/%llu", names[i],
+                       (unsigned long long)p->calls[i],
+                       (unsigned long long)(p->ticks[i] * 1000000 / pw_tf3_hz),
+                       (unsigned long long)(p->max[i] * 1000000 / pw_tf3_hz));
+    if (at < sizeof(line))
+        snprintf(line+at, sizeof(line)-at,
+                 " alert_results=%llu/%llu/%llu timed=%llu short_le100us=%llu fast_take=%llu park=%llu notify=%llu notify_skip=%llu stale=%llu",
+                 (unsigned long long)p->alert_woken, (unsigned long long)p->alert_timeouts,
+                 (unsigned long long)p->alert_errors, (unsigned long long)p->alert_timed,
+                 (unsigned long long)p->alert_short,
+                 (unsigned long long)p->alert_fast[0], (unsigned long long)p->alert_fast[1],
+                 (unsigned long long)p->alert_fast[2], (unsigned long long)p->alert_fast[3],
+                 (unsigned long long)p->alert_fast[4]);
+    fprintf(stderr, "%s\n", line);
+    p->alert_timed = p->alert_short = p->alert_timeouts = p->alert_woken = p->alert_errors = 0;
+    memset(p->alert_fast, 0, sizeof(p->alert_fast));
+    memset(p->calls, 0, sizeof(p->calls)); memset(p->ticks, 0, sizeof(p->ticks)); memset(p->max, 0, sizeof(p->max));
+    p->since = pw_tf3_rdtsc();
+    p->cpu_valid = pw_tf3_cpu(&p->cpu_us);
+}
+#endif
