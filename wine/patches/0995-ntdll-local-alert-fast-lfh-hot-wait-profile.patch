From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: local <local@invalid>
Date: Tue, 27 Oct 2026 02:00:00 +0100
Subject: [PATCH] ntdll: Local opt-in alert fast path, hot LFH bins and wait profiler.

Carried from the 2026-10-22 Transport Fever 3 build, all opt-in per profile:
PW_WINE_ALERT_FAST=1 (atomic pending flag, kqueue only to park/wake),
PW_WINE_LFH_HOT=1 (LFH for every eligible bin after 2048 allocations) and
PW_WINE_NT_PROFILE=1/2 (wait profiler and sparse scheduler observer).

diff --git a/dlls/ntdll/heap.c b/dlls/ntdll/heap.c
index feee54e..94b707e 100644
--- a/dlls/ntdll/heap.c
+++ b/dlls/ntdll/heap.c
@@ -1974,6 +1974,23 @@ static NTSTATUS heap_free_block_lfh( struct heap *heap, ULONG flags, struct bloc
     return status;
 }
 
+/* Opt-in for allocation-heavy titles: retain the existing LFH allocator,
+ * but allow hot medium-size bins to use it without 4 MiB of live blocks. */
+static BOOL heap_lfh_hot_policy(void)
+{
+    static LONG cached = -1;
+    LONG enabled = ReadAcquire(&cached);
+    static const UNICODE_STRING name = RTL_CONSTANT_STRING(L"PW_WINE_LFH_HOT");
+    WCHAR buffer[4];
+    UNICODE_STRING value = {0, sizeof(buffer), buffer};
+    if (enabled != -1) return enabled;
+    if (!NtCurrentTeb()->Peb->ProcessParameters || !NtCurrentTeb()->Peb->ProcessParameters->Environment) return FALSE;
+    enabled = !RtlQueryEnvironmentVariable_U(NULL, &name, &value) && value.Length == sizeof(WCHAR) && buffer[0] == 0x31;
+    if (InterlockedCompareExchange(&cached, enabled, -1) == -1 && enabled)
+        MESSAGE("PW_WINE_LFH_HOT version=1 enabled=1 min_alloc=2048 max_block=32768\n");
+    return enabled;
+}
+
 static void bin_try_enable( struct heap *heap, struct bin *bin )
 {
     ULONG alloc = ReadNoFence( &bin->count_alloc ), freed = ReadNoFence( &bin->count_freed );
@@ -1984,6 +2001,7 @@ static void bin_try_enable( struct heap *heap, struct bin *bin )
     else if (bin - heap->bins < 0x30 && alloc > 0x800) enable = TRUE;
     else if (bin - heap->bins < 0x30 && alloc - freed > 0x10) enable = TRUE;
     else if (alloc - freed > 0x400000 / block_size) enable = TRUE;
+    else if (alloc > 0x800 && bin - heap->bins < BLOCK_SIZE_BIN_COUNT - 1 && heap_lfh_hot_policy()) enable = TRUE;
     if (!enable) return;
 
     if (ReadNoFence( &heap->compat_info ) != HEAP_LFH)
