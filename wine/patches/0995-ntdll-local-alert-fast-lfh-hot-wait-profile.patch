diff --git a/dlls/ntdll/unix/pw_alert_fast.h b/dlls/ntdll/unix/pw_alert_fast.h
new file mode 100644
index 0000000..a2b5b32
--- /dev/null
+++ b/dlls/ntdll/unix/pw_alert_fast.h
@@ -0,0 +1,31 @@
+/* Per-thread auto-reset alert flag, with a kernel event only for parked waits.
+ * A late kernel notification is harmless: waiters recheck the atomic flag.
+ * There is one waiter per entry; any number of threads may signal it. */
+#ifndef PW_ALERT_FAST_H
+#define PW_ALERT_FAST_H
+#include <stdint.h>
+enum { PW_ALERT_PENDING = 1, PW_ALERT_PARKED = 2 };
+static inline int pw_alert_fast_take(uint32_t *state)
+{
+    uint32_t expected = PW_ALERT_PENDING;
+    return __atomic_compare_exchange_n(state, &expected, 0, 0,
+                                       __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+}
+static inline int pw_alert_fast_arm(uint32_t *state)
+{
+    uint32_t expected = 0;
+    return __atomic_compare_exchange_n(state, &expected, PW_ALERT_PARKED, 0,
+                                       __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE);
+}
+static inline int pw_alert_fast_signal(uint32_t *state)
+{
+    uint32_t old = __atomic_fetch_or(state, PW_ALERT_PENDING, __ATOMIC_ACQ_REL);
+    /* Notify every signal while parked. Besides allowing coalescing in the
+     * kernel, this lets a later signal retry an earlier failed notification. */
+    return !!(old & PW_ALERT_PARKED);
+}
+static inline int pw_alert_fast_finish(uint32_t *state)
+{
+    return !!(__atomic_exchange_n(state, 0, __ATOMIC_ACQ_REL) & PW_ALERT_PENDING);
+}
+#endif
