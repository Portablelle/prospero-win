+  for(link=&vk64_streams;*link && *link!=s;link=&(*link)->next){}
+  if(*link)*link=s->next;
+  cb->pw_batch64=NULL;ReleaseSRWLockExclusive(&vk64_registry_lock);free(s);
+ }
