+static NTSTATUS vk64_flush_locked(struct pw_vk64_stream *s)
+{
+ struct pw_vk64_packet p;NTSTATUS status;
+ if(!s || !s->used)return STATUS_SUCCESS;
+ p.version=PW_VK64_VERSION;p.bytes=s->used;p.data=(UINT_PTR)s->storage;
+ status=WINE_UNIX_CALL(unix_pw_vk_batch,&p);
+ if(!status)s->used=0;
+ return status;
+}
+static NTSTATUS vk64_flush(VkCommandBuffer cb)
+{
+ struct pw_vk64_stream *s=cb?cb->pw_batch64:NULL;NTSTATUS status;
+ if(!s)return STATUS_SUCCESS;
+ AcquireSRWLockExclusive(&s->lock);status=vk64_flush_locked(s);ReleaseSRWLockExclusive(&s->lock);
+ return status;
+}
+static NTSTATUS vk64_flush_all(void)
+{
+ struct pw_vk64_stream *s;NTSTATUS status=STATUS_SUCCESS;
+ /* No waits/submits or application callbacks under these locks. Registered
+  * streams cannot disappear while the finite synchronous replays run. */
+ AcquireSRWLockExclusive(&vk64_registry_lock);
+ for(s=vk64_streams;s;s=s->next) {
+  AcquireSRWLockExclusive(&s->lock);status=vk64_flush_locked(s);ReleaseSRWLockExclusive(&s->lock);
+  if(status)break;
+ }
+ ReleaseSRWLockExclusive(&vk64_registry_lock);return status;
+}
+void pw_vk64_discard(VkCommandBuffer cb,BOOL release)
+{
+ struct pw_vk64_stream *s=cb?cb->pw_batch64:NULL,**link;
+ if(!s)return;
