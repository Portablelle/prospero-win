+static NTSTATUS pw_vk64_replay(void *args)
+{
+ const struct pw_vk64_packet *p=args;
+ const unsigned char *data=(const unsigned char *)(uintptr_t)p->data;
+ size_t at=0;
+ if(!data || !p->bytes || p->bytes>PW_VK64_MAX_BYTES || (p->bytes&7) || ((uintptr_t)data&7))
+  return STATUS_INVALID_PARAMETER;
+ /* Validate the entire bounded stream before issuing any driver command. */
+ while(at<p->bytes) {
+  const struct pw_vk64_record *r=(const void *)(data+at);
+  if(p->bytes-at<sizeof(*r) || r->bytes>p->bytes-at-sizeof(*r) || (r->bytes&7) ||
+     !pw_vk64_valid(r->code,r+1,r->bytes))return STATUS_INVALID_PARAMETER;
+  at+=sizeof(*r)+r->bytes;
+ }
+ for(at=0;at<p->bytes;) {
+  const struct pw_vk64_record *r=(const void *)(data+at);
+  NTSTATUS status=pw_vk_batch_dispatch_native(r->code,(void *)(r+1));
+  if(status)return status;
+  at+=sizeof(*r)+r->bytes;
+ }
+ return STATUS_SUCCESS;
